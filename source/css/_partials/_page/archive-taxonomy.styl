/* ============== ARCHIVE / TAXONOMY ============== */
.archive-paper {
  --article-top-img-pad-top: 32px;
  --article-top-img-pad-x: 36px;
  padding: 32px 36px;
}

.taxonomy-paper,
.empty-paper {
  --article-top-img-pad-top: 24px;
  --article-top-img-pad-x: 28px;
  padding: 24px 28px;
}

.archive-paper--with-top-img,
.taxonomy-paper--with-top-img {
  overflow-x: clip;
}

.archive-paper--with-top-img .article-header h1,
.taxonomy-paper--with-top-img .article-header h1 {
  margin: 4px 0 0;
}

.archive-paper h1,
.taxonomy-paper h1,
.empty-paper h1 {
  margin: 0 0 18px;
  font-size: 24px;
  font-weight: 800;
}

.archive-list {
  display: grid;
  gap: 0;
}

.archive-item {
  display: grid;
  grid-template-columns: 110px 1fr 16px;
  gap: 16px;
  align-items: center;
  padding: 16px 0;
  border-bottom: 1px dashed var(--line);
  font-size: 14px;
  transition: color 0.22s ease;
}

.archive-item:last-child {
  border-bottom: 0;
}

.archive-item strong {
  font-size: 15px;
  font-weight: 600;
}

.archive-item > span {
  color: var(--muted);
  font-size: 13px;
  font-variant-numeric: tabular-nums;
}

/* hand-drawn arrow: faint at rest, inks in and slides forward on hover */
.archive-item em {
  width: 16px;
  height: 10px;
  background-color: var(--muted);
  opacity: 0.55;
  -webkit-mask: var(--mask-arrow) center / contain no-repeat;
  mask: var(--mask-arrow) center / contain no-repeat;
  transform: translateX(-4px);
  transition: background-color 0.22s ease, opacity 0.22s ease, transform 0.26s var(--ease-spring);
}

.archive-item strong {
  transition: color 0.22s ease, transform 0.26s var(--ease-paper);
}

.archive-item:hover strong,
.archive-item:focus-visible strong {
  color: var(--color-accent-strong);
  transform: translateX(3px);
}

.archive-item:hover em,
.archive-item:focus-visible em {
  background-color: var(--color-accent);
  opacity: 1;
  transform: translateX(0);
}

.dark-mode .archive-item:hover strong {
  color: var(--color-accent-muted);
}

.taxonomy-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 12px;
}

.taxonomy-grid .taxonomy-card {
  flex: 0 0 auto;
  min-width: 160px;
}

.taxonomy-card {
  display: grid;
  grid-template-columns: 12px 1fr auto;
  gap: 10px;
  align-items: center;
  min-height: 70px;
  padding: 16px;
  /* index card: same pencilled outline as the search results */
  border: 1px dashed var(--dash);
  border-radius: var(--radius-handdrawn-wide);
  background-color: var(--paper-warm);
  font-size: 14px;
  transition: color 0.2s ease, background-color 0.2s ease, border-color 0.2s ease, transform 0.26s var(--ease-paper), box-shadow 0.2s ease;
}

.taxonomy-card:hover {
  color: var(--color-accent-strong);
  border-color: var(--color-accent);
  background-color: var(--color-accent-soft);
  box-shadow: var(--soft-shadow);
  transform: translateY(-2px) rotate(-0.8deg);
}

.taxonomy-card:nth-child(even):hover {
  transform: translateY(-2px) rotate(0.8deg);
}

.taxonomy-card:hover em {
  color: inherit;
}

.taxonomy-card:hover .dot {
  transform: rotate(5deg) scale(1.24);
}

.dark-mode .taxonomy-card:hover {
  color: var(--color-accent-muted);
}

.taxonomy-paper > .tag-cloud {
  gap: 14px;
}

.taxonomy-paper > .tag-cloud .tag-chip:nth-child(3n) {
  transform: rotate(-1.5deg);
}
.taxonomy-paper > .tag-cloud .tag-chip:nth-child(3n + 1) {
  transform: rotate(1deg);
}
.taxonomy-paper > .tag-cloud .tag-chip:nth-child(5n) {
  transform: rotate(-0.5deg);
}

.taxonomy-paper > .tag-cloud .tag-chip:hover {
  transform: translateY(-3px) scale(1.05) rotate(0deg);
}

/* Empty-collection message on the tags / categories pages, matching
   .search-empty's look. */
.empty-state {
  margin: 24px 0 8px;
  text-align: center;
  color: var(--muted);
  font-size: 13px;
}
