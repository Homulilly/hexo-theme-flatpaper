/* ============== ARROW LINK ============== */
/* Forward / back links written by hand: plain text with a pen-drawn arrow,
   no box. Used for the welcome card's call to action, "read more" on the
   featured post and the list pager. On hover the text gets the highlighter
   swipe (the label carries .marker-swipe, see _global/marker-swipe.styl) and
   the arrow slides the way it points.

   The arrow is a pseudo-element, so the templates carry only the label. */
.welcome-cta,
.read-more,
.pager-link {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  padding: 4px 2px;
  color: var(--ink);
  font-size: 14px;
  font-weight: 600;
  line-height: 1.75;
  white-space: nowrap;
  text-decoration: none;
  transition: color 0.2s ease;
}

.welcome-cta::after,
.read-more::after,
.pager-link--next::after,
.pager-link--prev::before {
  content: "";
  flex: 0 0 22px;
  height: 13px;
  background-color: currentColor;
  -webkit-mask: var(--mask-arrow) center / contain no-repeat;
  mask: var(--mask-arrow) center / contain no-repeat;
  transition: transform 0.26s var(--ease-spring);
}

/* the same stroke, mirrored, for "previous" */
.pager-link--prev::before {
  transform: scaleX(-1);
}

.welcome-cta:hover,
.welcome-cta:focus-visible,
.read-more:hover,
.read-more:focus-visible,
a.pager-link:hover,
a.pager-link:focus-visible {
  color: var(--color-accent-strong);
}

.dark-mode .welcome-cta:hover,
.dark-mode .welcome-cta:focus-visible,
.dark-mode .read-more:hover,
.dark-mode .read-more:focus-visible,
.dark-mode a.pager-link:hover,
.dark-mode a.pager-link:focus-visible {
  color: var(--color-accent-muted);
}

.welcome-cta:hover::after,
.read-more:hover::after,
a.pager-link--next:hover::after {
  transform: translateX(5px);
}

a.pager-link--prev:hover::before {
  transform: scaleX(-1) translateX(5px);
}

@media (prefers-reduced-motion: reduce) {
  .welcome-cta::after,
  .read-more::after,
  .pager-link--next::after,
  .pager-link--prev::before {
    transition: none;
  }
}
