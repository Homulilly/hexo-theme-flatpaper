/* ============== PAGER ============== */
.pager {
  display: flex;
  justify-content: center;
  align-items: center;
  gap: 14px;
  margin-top: 28px;
}

/* Button look comes from _global/paper-button.styl. */
.pager-link {
  width: 112px;
}

.pager-link.is-disabled {
  opacity: 0.45;
  cursor: not-allowed;
  color: var(--muted);
}

.pager-pages {
  color: var(--muted);
  font-size: 13px;
  font-variant-numeric: tabular-nums;
  letter-spacing: 0.04em;
}

