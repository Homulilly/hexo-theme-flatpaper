/* ============== HOME HERO CTA ============== */
// The bottom sticker button. Paper mode draws the card in CSS and tints it
// from --cta-hue; presets 01-09 (cta_background) pick a hue + sticker pair
// modelled on the original cta-bg-0x artwork, and cta_color / cta_sticker
// override either half. Each sticker SVG is drawn on a 64x56 canvas with the
// card's top-left corner at (10, 10) and carries its own size and position,
// so the CSS only supplies the slot. A custom cta_background image falls back
// to the old image-backed button (--bg-image).
.home-hero__arrow {
  position: absolute;
  left: 50%;
  bottom: 13px;
  z-index: 4;
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--ink);
  font-size: 14px;
  font-weight: 700;
  line-height: 1;
  letter-spacing: 0;
  text-decoration: none;
  transform: translateX(-50%) rotate(-0.6deg);
  transition: transform 0.24s ease, box-shadow 0.24s ease;
  animation: pull-tab-breathe 2.8s ease-in-out infinite;
}

.home-hero__arrow:hover,
.home-hero__arrow:focus-visible {
  transform: translateX(-50%) translateY(4px) rotate(0.4deg);
  animation: pull-tab-hover-press 1.2s ease-in-out infinite;
  outline: none;
}

.home-hero__arrow-text {
  display: block;
  min-width: 0;
  padding-block: 0.08em;
  overflow: hidden;
  line-height: 1.24;
  text-overflow: ellipsis;
  white-space: nowrap;
}

@keyframes pull-tab-breathe {
  0%, 100% { transform: translateX(-50%) translateY(0) rotate(-0.6deg); }
  50% { transform: translateX(-50%) translateY(3px) rotate(0.4deg); }
}

@keyframes pull-tab-hover-press {
  0%, 100% { transform: translateX(-50%) translateY(4px) rotate(0.4deg); }
  50% { transform: translateX(-50%) translateY(7px) rotate(-0.4deg); }
}

/* ---------- Paper card ---------- */
.home-hero__arrow--paper {
  --cta-hue: #b08968;
  --cta-fill: unquote('color-mix(in srgb, var(--cta-hue) 13%, var(--paper))');
  --cta-edge: unquote('color-mix(in srgb, var(--cta-hue) 42%, var(--paper))');
  --cta-edge-strong: unquote('color-mix(in srgb, var(--cta-hue) 58%, var(--paper))');
  --cta-lip: unquote('color-mix(in srgb, var(--cta-hue) 30%, var(--paper))');
  --cta-stitch: unquote('color-mix(in srgb, var(--cta-hue) 50%, transparent)');
  --cta-icon: unquote('color-mix(in srgb, var(--cta-hue) 55%, var(--ink))');
  --cta-shadow: unquote('rgba(var(--paper-shadow-rgb), 0.14)');
  gap: 8px;
  height: 44px;
  max-width: unquote('min(80vw, 300px)');
  padding: 0 18px 0 48px;
  background: var(--cta-fill);
  border-radius: 17px 14px 18px 13px / 14px 18px 13px 17px;
  box-shadow: inset 0 0 0 1.5px var(--cta-edge), 0 3px 0 var(--cta-lip), 0 9px 16px var(--cta-shadow);
}

.home-hero__arrow--paper::after {
  content: "";
  position: absolute;
  inset: 5px;
  border: 1.5px dashed var(--cta-stitch);
  border-radius: 12px 10px 13px 9px;
  pointer-events: none;
}

.home-hero__arrow--paper:hover,
.home-hero__arrow--paper:focus-visible {
  box-shadow: inset 0 0 0 1.5px var(--cta-edge-strong), 0 1px 0 var(--cta-lip), 0 4px 8px var(--cta-shadow);
}

.home-hero__arrow--paper .home-hero__arrow-icon {
  flex: none;
  width: 16px;
  height: 16px;
  margin-left: auto;
  color: var(--cta-icon);
  stroke-width: 2.4;
}

.home-hero__arrow-sticker {
  position: absolute;
  left: -10px;
  top: -10px;
  // Above the ::after stitch, since the art sits partly inside the card.
  z-index: 1;
  width: 64px;
  height: 56px;
  background-position: 0 0;
  background-repeat: no-repeat;
  background-size: 100% 100%;
  filter: drop-shadow(0 1px 1px unquote('rgba(var(--paper-shadow-rgb), 0.12)'));
  transform-origin: 36% 46%;
  transition: transform 0.3s cubic-bezier(0.3, 1.6, 0.5, 1);
  pointer-events: none;
}

.home-hero__arrow--paper:hover .home-hero__arrow-sticker,
.home-hero__arrow--paper:focus-visible .home-hero__arrow-sticker {
  transform: rotate(-6deg) scale(1.06);
}

.home-hero--image .home-hero__arrow--paper {
  --cta-shadow: rgba(20, 16, 12, 0.3);
}

.dark-mode .home-hero__arrow--paper {
  --cta-shadow: rgba(0, 0, 0, 0.32);
}

// The pastel art washes out against the dark card, so deepen it a little.
// A custom image sticker keeps its own filter (higher specificity).
.dark-mode .home-hero__arrow-sticker {
  filter: unquote('saturate(1.3) brightness(0.9) drop-shadow(0 1px 1px rgba(var(--paper-shadow-rgb), 0.12))');
}

/* ---------- Presets (cta_background 01-09) ---------- */
.home-hero__arrow[data-cta-preset="02"] { --cta-hue: #e8899a; }
.home-hero__arrow[data-cta-preset="03"] { --cta-hue: #c8935f; }
.home-hero__arrow[data-cta-preset="04"] { --cta-hue: var(--orange); }
.home-hero__arrow[data-cta-preset="05"] { --cta-hue: var(--green); }
.home-hero__arrow[data-cta-preset="06"] { --cta-hue: var(--yellow); }
.home-hero__arrow[data-cta-preset="07"] { --cta-hue: var(--blue); }
.home-hero__arrow[data-cta-preset="08"] { --cta-hue: var(--violet); }
.home-hero__arrow[data-cta-preset="09"] { --cta-hue: var(--blue); }

// cta_color: same specificity as the presets, declared later so it wins.
.home-hero__arrow[data-cta-color="brown"] { --cta-hue: #b08968; }
.home-hero__arrow[data-cta-color="pink"] { --cta-hue: #e8899a; }
.home-hero__arrow[data-cta-color="orange"] { --cta-hue: var(--orange); }
.home-hero__arrow[data-cta-color="green"] { --cta-hue: var(--green); }
.home-hero__arrow[data-cta-color="yellow"] { --cta-hue: var(--yellow); }
.home-hero__arrow[data-cta-color="blue"] { --cta-hue: var(--blue); }
.home-hero__arrow[data-cta-color="violet"] { --cta-hue: var(--violet); }
.home-hero__arrow[data-cta-color="accent"] { --cta-hue: var(--color-accent); }

/* ---------- Stickers ---------- */
.home-hero__arrow[data-cta-preset="01"]:not([data-cta-sticker]),
.home-hero__arrow[data-cta-sticker="none"] {
  padding-left: 20px;
}

.home-hero__arrow[data-cta-preset="01"]:not([data-cta-sticker]) .home-hero__arrow-sticker,
.home-hero__arrow[data-cta-sticker="none"] .home-hero__arrow-sticker {
  display: none;
}

