// cta_sticker as an image path: the site's own artwork in a square slot.
.home-hero__arrow[data-cta-sticker="custom"] .home-hero__arrow-sticker {
  left: -8px;
  top: 50%;
  width: 44px;
  height: 44px;
  background-image: var(--cta-sticker);
  background-position: center;
  background-size: contain;
  filter: drop-shadow(0 2px 3px unquote('rgba(var(--paper-shadow-rgb), 0.22)'));
  transform: translateY(-62%) rotate(-10deg);
  transform-origin: 50% 50%;
}

.home-hero__arrow[data-cta-sticker="custom"]:hover .home-hero__arrow-sticker,
.home-hero__arrow[data-cta-sticker="custom"]:focus-visible .home-hero__arrow-sticker {
  transform: translateY(-70%) rotate(6deg) scale(1.08);
}

/* ---------- Image-backed button (custom cta_background) ---------- */
.home-hero__arrow--bg-image {
  width: 180px;
  height: 60px;
  padding: 15px 42px 15px 28px;
  color: #684029;
  background-image: var(--hero-cta-bg);
  background-repeat: no-repeat;
  background-position: center;
  background-size: contain;
  filter: drop-shadow(0 8px 14px unquote('rgba(var(--paper-shadow-rgb), 0.14)'));
}

.home-hero__arrow--bg-image .home-hero__arrow-text {
  width: 100%;
  text-align: center;
  text-shadow: 0 1px 0 rgba(255, 253, 246, 0.72);
  transform: translate(3px, -1px);
}

.home-hero__arrow--bg-image:hover,
.home-hero__arrow--bg-image:focus-visible {
  color: #54311f;
}

.home-hero--image .home-hero__arrow--bg-image {
  filter: drop-shadow(0 9px 16px rgba(20, 16, 12, 0.28));
}

.dark-mode .home-hero__arrow--bg-image {
  filter: drop-shadow(0 10px 16px rgba(0, 0, 0, 0.24));
}

.dark-mode .home-hero--image .home-hero__arrow--bg-image {
  filter: drop-shadow(0 10px 18px rgba(0, 0, 0, 0.4));
}

@media (max-width: 760px) {
  .home-hero__arrow {
    bottom: 11px;
    font-size: 13px;
  }

  .home-hero__arrow--paper {
    height: 40px;
    padding: 0 16px 0 42px;
  }

  .home-hero__arrow--paper .home-hero__arrow-icon {
    width: 15px;
    height: 15px;
  }

  // 40/44 of the desktop slot, keeping the card-relative layout.
  .home-hero__arrow-sticker {
    left: -9px;
    top: -9px;
    width: 58px;
    height: 51px;
  }

  .home-hero__arrow[data-cta-sticker="custom"] .home-hero__arrow-sticker {
    left: -6px;
    top: 50%;
    width: 38px;
    height: 38px;
  }

  .home-hero__arrow--bg-image {
    width: 150px;
    height: 50px;
    padding: 13px 34px 12px 24px;
  }
}

@media (prefers-reduced-motion: reduce) {
  .home-hero__arrow,
  .home-hero__arrow:hover,
  .home-hero__arrow:focus-visible {
    animation: none;
  }

  .home-hero__arrow-sticker {
    transition: none;
  }
}
