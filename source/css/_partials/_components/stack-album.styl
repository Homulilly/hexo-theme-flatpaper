/* ============== STACKED ALBUM ============== */
/* {% stackalbum %} / {% stackalbumnav %} — a deck of photos stacked like
   playing cards. Markup comes from scripts/stackalbum.js, behaviour from
   main.js's initStackAlbums().

   Two states, and the unstacked one is what ships in the HTML: cards are
   ordinary blocks and every photo is visible, so a reader without JS gets the
   whole album as a plain image list. main.js adds `is-stacked` to switch to
   the deck, which is the only state that positions cards absolutely. */

.fp-stack {
  /* Card footprints per orientation. The modifier below only picks one of
     these pairs, so the nav variant restates the numbers and nothing else. */
  --fp-card-h-w: 480px;
  --fp-card-h-h: 320px;
  --fp-card-v-w: 320px;
  --fp-card-v-h: 480px;
  width: var(--fp-stack-w, 480px);
  max-width: 100%;
  margin: 1.6em auto;
}

.fp-stack--nav {
  --fp-card-h-w: 160px;
  --fp-card-h-h: 107px;
  --fp-card-v-w: 120px;
  --fp-card-v-h: 160px;
  flex: 0 0 auto;
  margin: 0;
}

.fp-stack__card {
  display: block;
  position: relative;
}

.fp-stack__card + .fp-stack__card {
  margin-top: 10px;
}

.fp-stack__img {
  display: block;
  width: 100%;
  height: auto;
  border: 1px solid var(--line);
  background: var(--paper);
}

/* The photo frame, restated at a specificity that can win.
   `.article-content img` (_page/article.styl) styles prose images for the
   whole theme: border-radius 0, no shadow, and a hover that shifts the image
   by 5px. It is (0,1,1) and imported after this file, so the rule above can
   reach neither the radius nor the shadow — and the prose hover would slide a
   photo inside its own card, which is not what a deck of photos should do.
   Cancelling it here keeps the frame in one place instead of spreading it
   across both states. */
.fp-stack .fp-stack__img,
.fp-stack .fp-stack__img:hover {
  border-radius: 10px;
  box-shadow: var(--paper-shadow);
  transform: none;
}

/* ---- Deck ---- */

.fp-stack.is-stacked {
  position: relative;
  height: var(--fp-stack-h, 480px);
}

/* The top card is the click target, but the container carries the keyboard
   affordance (main.js gives it tabindex), so the focus ring belongs here — and
   it has to be drawn explicitly: the cards overflow the container, and a UA
   outline hugging the box alone reads as unrelated to the photos. */
.fp-stack.is-stacked:focus-visible {
  outline: 2px solid var(--color-accent-strong);
  outline-offset: 8px;
  border-radius: 12px;
}

.fp-stack.is-stacked .fp-stack__card {
  position: absolute;
  left: 50%;
  top: 50%;
  width: var(--fp-card-v-w);
  height: var(--fp-card-v-h);
  margin: 0;
  user-select: none;
  -webkit-user-select: none;
  /* Where layout() puts a card before fanning it out. Without it a card
     starts with its corner on the deck's centre, i.e. down and to the right
     of where it belongs. */
  transform: translate(-50%, -50%);
  will-change: transform;
}

/* Cards animate only once the deck has been laid out (main.js adds
   `is-ready` after the first layout, and drops it again while a late image
   settles its orientation). Before that, every card would visibly slide in
   from the bottom right and morph to its size on each page load. */
.fp-stack.is-stacked.is-ready .fp-stack__card {
  transition: transform 0.38s ease, width 0.3s ease, height 0.3s ease;
}

.fp-stack.is-stacked .fp-stack__card--h {
  width: var(--fp-card-h-w);
  height: var(--fp-card-h-h);
}

.fp-stack.is-stacked .fp-stack__card--v {
  width: var(--fp-card-v-w);
  height: var(--fp-card-v-h);
}

/* Only the article deck is clickable — the nav deck is driven by its title
   list, so a pointer cursor there would promise an interaction it lacks. */
.fp-stack.is-stacked:not(.fp-stack--nav) .fp-stack__card.is-top {
  cursor: pointer;
}

.fp-stack.is-stacked .fp-stack__img {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  object-fit: cover;
  filter: blur(3px) saturate(0.85);
}

.fp-stack.is-stacked.is-ready .fp-stack__img {
  transition: transform 0.38s ease, filter 0.3s ease;
}

.fp-stack--nav.is-stacked .fp-stack__img {
  filter: blur(2.5px) saturate(0.85);
}

/* The top photo is the only sharp one, and the deeper shadow is what lifts it
   clear of the blurred pile rather than sitting flush against it. */
.fp-stack.is-stacked .fp-stack__card.is-top .fp-stack__img {
  filter: none;
  box-shadow: var(--small-shadow);
}

.fp-stack.is-stacked:not(.fp-stack--nav) .fp-stack__card.is-top:hover .fp-stack__img {
  filter: brightness(1.05);
}

/* The lift, before the card drops to the back of the pile. */
.fp-stack.is-stacked .fp-stack__card.is-taking {
  z-index: 9999;
  transition: transform 0.26s ease;
}

.fp-stack.is-stacked .fp-stack__card.is-taking .fp-stack__img {
  filter: none;
  box-shadow: var(--shadow);
  transition: transform 0.26s ease, filter 0.3s ease;
}

/* ---- Nav variant: deck + title list ---- */

/* List and deck are one figure: kept side by side and centred in the column
   like the article deck, rather than pushed to opposite edges, so it is plain
   which pile a title flips. */
.fp-stacknav {
  display: flex;
  flex-direction: row-reverse;
  align-items: center;
  justify-content: center;
  flex-wrap: wrap;
  gap: 24px 44px;
  margin: 1.6em 0;
}

/* The article stylesheet styles lists inside .article-content, so the reset
   has to be specific enough to win against it. */
.article-content .fp-stacknav__list {
  display: flex;
  flex-direction: column;
  gap: 8px;
  min-width: 200px;
  /* long titles wrap inside their card instead of shoving the deck away */
  max-width: 340px;
  margin: 0;
  padding: 0;
  list-style: none;
}

/* Title buttons: one pencilled index card per entry — the same recipe as the
   search results and the category cards — in a column beside the deck.
   Hovering one flips its cover to the top (main.js), so the card leans
   towards the deck and a hand-drawn arrow inks in on that side.

   The selector is this long on purpose: `.article-content a` and its
   dark-mode twin (_page/article.styl) colour every anchor in prose at up to
   (0,3,1), and these are buttons, not prose links. */
.article-content .fp-stacknav .fp-stacknav__list .fp-stacknav__link {
  position: relative;
  display: block;
  padding: 7px 38px 7px 14px;
  border: 1px dashed var(--dash);
  border-radius: var(--radius-handdrawn-wide);
  color: var(--ink-soft);
  background-color: var(--paper-warm);
  font-size: 14px;
  font-weight: 600;
  line-height: 1.5;
  text-decoration: none;
  transition:
    color 0.2s ease,
    background-color 0.2s ease,
    border-color 0.2s ease,
    box-shadow 0.2s ease,
    transform 0.26s var(--ease-paper);
}

.fp-stacknav__link::after {
  content: "";
  position: absolute;
  top: 50%;
  right: 13px;
  width: 16px;
  height: 10px;
  margin-top: -5px;
  background-color: currentColor;
  opacity: 0;
  -webkit-mask: var(--mask-arrow) center / contain no-repeat;
  mask: var(--mask-arrow) center / contain no-repeat;
  transform: translateX(-6px);
  transition: opacity 0.2s ease, transform 0.26s var(--ease-spring);
}

.article-content .fp-stacknav .fp-stacknav__list .fp-stacknav__link:hover,
.article-content .fp-stacknav .fp-stacknav__list .fp-stacknav__link:focus-visible {
  color: var(--color-accent-strong);
  border-color: var(--color-accent);
  background-color: var(--color-accent-soft);
  box-shadow: var(--soft-shadow);
  transform: translateX(4px) rotate(-0.6deg);
}

.article-content .fp-stacknav .fp-stacknav__list li:nth-child(even) .fp-stacknav__link:hover,
.article-content .fp-stacknav .fp-stacknav__list li:nth-child(even) .fp-stacknav__link:focus-visible {
  transform: translateX(4px) rotate(0.6deg);
}

.dark-mode .article-content .fp-stacknav .fp-stacknav__list .fp-stacknav__link:hover,
.dark-mode .article-content .fp-stacknav .fp-stacknav__list .fp-stacknav__link:focus-visible {
  color: var(--color-accent-muted);
}

.fp-stacknav__link:hover::after,
.fp-stacknav__link:focus-visible::after {
  opacity: 1;
  transform: translateX(0);
}

/* pressed: the card is pushed back onto the page */
.article-content .fp-stacknav .fp-stacknav__list .fp-stacknav__link:active {
  box-shadow: none;
  transform: translateX(2px);
  transition-duration: 0.08s;
}

@media (max-width: 480px) {
  .fp-stacknav {
    flex-direction: column;
    flex-wrap: nowrap;
    align-items: center;
    justify-content: flex-start;
    gap: 16px;
  }

  .fp-stack--nav {
    width: 160px;
    max-width: 100%;
  }

  .article-content .fp-stacknav__list {
    width: 100%;
    min-width: 0;
    max-width: none;
    text-align: center;
  }

  /* Deck sits above the list here, so the cards stay level instead of
     leaning sideways, and the padding is evened out to keep titles centred. */
  .article-content .fp-stacknav .fp-stacknav__list .fp-stacknav__link {
    padding-left: 38px;
    overflow-wrap: anywhere;
  }

  .article-content .fp-stacknav .fp-stacknav__list li .fp-stacknav__link:hover,
  .article-content .fp-stacknav .fp-stacknav__list li .fp-stacknav__link:focus-visible {
    transform: translateY(-2px);
  }
}

@media (prefers-reduced-motion: reduce) {
  /* The deck still reorders on click, it just does so without the travel. */
  .fp-stack.is-stacked.is-ready .fp-stack__card,
  .fp-stack.is-stacked .fp-stack__card.is-taking,
  .fp-stack.is-stacked.is-ready .fp-stack__img,
  .fp-stack.is-stacked .fp-stack__card.is-taking .fp-stack__img,
  .article-content .fp-stacknav .fp-stacknav__list .fp-stacknav__link,
  .fp-stacknav__link::after {
    transition: none;
  }
}
