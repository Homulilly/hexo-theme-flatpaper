/* ============== GUESTBOOK WALL ============== */
/* Messages re-rendered as sticky notes taped to the page, in the same look
   as the home-hero builtin note (.hero-sticker--note): opaque candy-colored
   paper, hard offset shadow, square corners, a short washi tape on top and a
   visible tilt. Paper/ink pair comes from the --p0..--p4 modifier class,
   tape color and tilt from inline custom props — all derived from a stable
   per-comment hash in main.js. Paper stays bright in dark mode (like the
   hero note); only its ink is baked to match. */

.article-paper.guestbook-page {
  padding-bottom: 64px;
}

.guestbook-subtitle {
  margin: 8px 0 0;
  color: var(--muted);
  font-size: 14px;
}

.guestbook-intro {
  margin-bottom: 8px;
}

.guestbook-wall {
  padding-top: 22px;
}

.guestbook-wall__summary {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 8px;
  margin-bottom: 18px;
}

.guestbook-wall__stat,
.guestbook-wall__write {
  display: inline-flex;
  align-items: center;
  min-height: 28px;
  padding: 4px 10px;
  border: 1px dashed var(--dash);
  border-radius: 999px;
  background: var(--paper-warm);
  color: var(--muted);
  font-size: 12px;
  line-height: 1.4;
}

.guestbook-wall__write {
  color: var(--color-accent-strong);
  text-decoration: none;
  transition: color 0.18s ease, border-color 0.18s ease, transform 0.18s ease;
}

.guestbook-wall__write:hover {
  border-color: var(--color-accent);
  transform: translateY(-1px);
}

.dark-mode .guestbook-wall__write {
  color: var(--color-accent-muted);
}

.guestbook-wall__state {
  margin: 18px 0 8px;
  padding: 14px 16px;
  border: 1px dashed var(--dash);
  border-radius: 8px;
  background: var(--paper-warm);
  color: var(--muted);
  font-size: 13px;
  text-align: center;
}

.guestbook-wall__state.is-error {
  color: #b35a4a;
  border-color: rgba(179, 90, 74, 0.34);
}

.dark-mode .guestbook-wall__state.is-error {
  color: #e39a8b;
  border-color: rgba(227, 154, 139, 0.32);
}

.guestbook-wall__list {
  columns: 2;
  column-gap: 20px;
  margin: 0;
  padding: 10px 0 0;
  list-style: none;
}

.guestbook-card {
  --gb-rotate: 0deg;
  --gb-tape: var(--tape-yellow);
  --gb-paper: #fff1a8;
  --gb-ink: #6a5430;
  position: relative;
  display: block;
  break-inside: avoid;
  margin: 4px 0 22px;
  padding: 16px 16px 12px;
  color: var(--gb-ink);
  background: var(--gb-paper);
  box-shadow: 5px 7px 0 unquote('rgba(var(--paper-shadow-rgb), 0.1)');
  transform: rotate(var(--gb-rotate));
  transition: transform 0.2s ease, box-shadow 0.2s ease;
}

.guestbook-card:hover {
  transform: rotate(0deg) translateY(-2px);
  box-shadow: 6px 9px 0 unquote('rgba(var(--paper-shadow-rgb), 0.13)');
  z-index: 2;
}

/* Same candy palette family as the hero note (#fff1a8 / #6a5430). */
.guestbook-card--p1 {
  --gb-paper: #ffddd6;
  --gb-ink: #7a463c;
}

.guestbook-card--p2 {
  --gb-paper: #d9efd7;
  --gb-ink: #44603f;
}

.guestbook-card--p3 {
  --gb-paper: #d8e9f8;
  --gb-ink: #3e5a76;
}

.guestbook-card--p4 {
  --gb-paper: #f6e4c6;
  --gb-ink: #6d5432;
}

.guestbook-card__tape {
  position: absolute;
  top: -8px;
  left: 50%;
  width: 52px;
  height: 16px;
  background-color: var(--gb-tape);
  background-image: var(--tape-stripes);
  filter: saturate(0.88);
  transform: translateX(-50%) rotate(4deg);
}

.guestbook-card__meta {
  display: flex;
  align-items: center;
  gap: 10px;
  margin-bottom: 10px;
}

.guestbook-card__avatar {
  flex: none;
  width: 34px;
  height: 34px;
  border-radius: 50%;
  object-fit: cover;
  background: rgba(255, 255, 255, 0.55);
  box-shadow: var(--paper-shadow);
}

.guestbook-card__avatar--text {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  color: inherit;
  font-size: 15px;
  font-weight: 700;
}

.guestbook-card__who {
  display: flex;
  flex-direction: column;
  min-width: 0;
}

.guestbook-card__nick {
  color: inherit;
  font-size: 14px;
  font-weight: 700;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.guestbook-card__date {
  color: inherit;
  opacity: 0.65;
  font-size: 12px;
  font-style: italic;
  letter-spacing: 0.04em;
}

.guestbook-card__text {
  display: -webkit-box;
  margin: 0;
  color: inherit;
  font-size: 14px;
  line-height: 1.7;
  white-space: pre-line;
  overflow-wrap: anywhere;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 10;
  overflow: hidden;
}

.guestbook-card__jump {
  display: inline-flex;
  margin-top: 10px;
  border-bottom: 1px dashed currentColor;
  color: inherit;
  opacity: 0.68;
  font-size: 12px;
  text-decoration: none;
  transition: opacity 0.18s ease;
}

.guestbook-card__jump:hover {
  opacity: 1;
}

/* Brief highlight on the original Twikoo comment after a wall jump. */
.guestbook-jump-target {
  outline: 2px dashed var(--color-accent);
  outline-offset: 6px;
  border-radius: 4px;
}

.guestbook-wall__more {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  min-width: 132px;
  margin: 28px auto 0;
  padding: 8px 18px;
  border: none;
  background: transparent;
  color: var(--ink-soft);
  font-size: 13px;
  font-weight: 600;
  cursor: pointer;
  white-space: nowrap;
  transition: color 0.2s ease, transform 0.2s ease;
  z-index: 1;
}

.guestbook-wall__more::before {
  content: "";
  position: absolute;
  top: 0; left: 0; right: 0; bottom: 0;
  background: var(--paper-warm);
  z-index: -1;
  border-radius: 4px;
  box-shadow: inset 0 0 0 1px var(--dash);
  filter: url(#paper-edge) drop-shadow(var(--paper-shadow));
  transition: background 0.2s ease, box-shadow 0.2s ease;
}

.guestbook-wall__more:hover,
.guestbook-wall__more:focus-visible {
  color: var(--color-accent-strong);
  transform: translateY(-1px);
}

.guestbook-wall__more:hover::before,
.guestbook-wall__more:focus-visible::before {
  background: var(--color-accent-soft);
  box-shadow: inset 0 0 0 1px var(--color-accent);
}

.dark-mode .guestbook-wall__more::before {
  box-shadow: none;
}

@media (max-width: 640px) {
  .guestbook-wall__list {
    columns: 1;
  }

  .guestbook-card {
    padding: 16px 14px 12px;
  }
}

@media (prefers-reduced-motion: reduce) {
  .guestbook-card,
  .guestbook-wall__write,
  .guestbook-wall__more,
  .guestbook-card__jump {
    transition: none;
  }

  .guestbook-card:hover {
    transform: rotate(var(--gb-rotate));
  }
}
