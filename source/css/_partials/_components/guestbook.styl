/* ============== GUESTBOOK WALL ============== */
/* Messages re-rendered as small envelope cards. Paper/ink pair
   comes from the --p0..--p4 modifier class, tape color and tilt from inline
   custom props — all derived from a stable per-comment hash in main.js. */

.article-paper.guestbook-page {
  padding-bottom: 64px;
}

.guestbook-subtitle {
  margin: 8px 0 0;
  color: var(--muted);
  font-size: 14px;
}

.guestbook-intro {
  margin-bottom: 8px;
}

.guestbook-wall {
  padding-top: 22px;
}

.guestbook-wall__summary {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 8px;
  margin-bottom: 18px;
}

.guestbook-wall__stat,
.guestbook-wall__write {
  display: inline-flex;
  align-items: center;
  min-height: 28px;
  padding: 4px 10px;
  border: 1px dashed unquote('rgba(var(--paper-shadow-rgb), 0.14)');
  border-radius: var(--radius-handdrawn);
  background: var(--paper-warm);
  color: var(--muted);
  font-size: 12px;
  line-height: 1.4;
}

.guestbook-wall__write {
  color: var(--color-accent-strong);
  text-decoration: none;
  transition: color 0.18s ease, border-color 0.18s ease, transform 0.18s ease;
}

.guestbook-wall__write:hover {
  border-color: var(--color-accent);
  transform: translateY(-1px);
}

.dark-mode .guestbook-wall__write {
  color: var(--color-accent-muted);
}

.guestbook-wall__state {
  margin: 18px 0 8px;
  padding: 14px 16px;
  border: 1px dashed var(--dash);
  border-radius: var(--radius-handdrawn);
  background: var(--paper-warm);
  color: var(--muted);
  font-size: 13px;
  text-align: center;
}

.guestbook-wall__state.is-error {
  color: #b35a4a;
  border-color: rgba(179, 90, 74, 0.34);
}

.dark-mode .guestbook-wall__state.is-error {
  color: #e39a8b;
  border-color: rgba(227, 154, 139, 0.32);
}

.guestbook-wall__list {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(232px, 1fr));
  gap: 26px 22px;
  margin: 0;
  padding: 12px 0 0;
  list-style: none;
}

.guestbook-card {
  --gb-rotate: 0deg;
  --gb-tape: var(--tape-yellow);
  --gb-paper: #fff1a8;
  --gb-ink: #6a5430;
  --gb-crease: rgba(106, 84, 48, 0.16);
  position: relative;
  display: flex;
  flex-direction: column;
  break-inside: avoid;
  aspect-ratio: 1.48 / 1;
  min-height: 154px;
  margin: 4px;
  padding: 18px 18px 14px;
  border: 1px solid unquote('rgba(var(--paper-shadow-rgb), 0.08)');
  border-radius: 4px;
  color: var(--gb-ink);
  background: var(--gb-paper);
  box-shadow: 5px 7px 0 unquote('rgba(var(--paper-shadow-rgb), 0.1)'), 0 10px 18px -14px unquote('rgba(var(--paper-shadow-rgb), 0.28)');
  transform: rotate(var(--gb-rotate));
  transform-origin: 48% 42%;
  transition: transform 0.2s ease, box-shadow 0.2s ease;
  overflow: hidden;
}

.guestbook-card::before,
.guestbook-card::after {
  content: "";
  position: absolute;
  pointer-events: none;
}

.guestbook-card::before {
  inset: 0;
  background:
    linear-gradient(31deg, transparent 49.3%, var(--gb-crease) 50%, transparent 50.7%) left bottom / 50.2% 60% no-repeat,
    linear-gradient(-31deg, transparent 49.3%, var(--gb-crease) 50%, transparent 50.7%) right bottom / 50.2% 60% no-repeat;
  opacity: 0.9;
  z-index: 0;
}

.guestbook-card::after {
  top: 0;
  left: 0;
  right: 0;
  height: 54%;
  background:
    linear-gradient(148deg, transparent 49.4%, var(--gb-crease) 50%, transparent 50.6%) left top / 50.2% 100% no-repeat,
    linear-gradient(-148deg, transparent 49.4%, var(--gb-crease) 50%, transparent 50.6%) right top / 50.2% 100% no-repeat,
    linear-gradient(to bottom, rgba(255, 255, 255, 0.18), transparent 72%);
  clip-path: polygon(0 0, 100% 0, 50% 100%);
  z-index: 0;
}

.guestbook-card > * {
  position: relative;
  z-index: 1;
}

.guestbook-card:hover {
  transform: rotate(0deg) translateY(-2px);
  box-shadow: 6px 9px 0 unquote('rgba(var(--paper-shadow-rgb), 0.13)'), 0 14px 22px -15px unquote('rgba(var(--paper-shadow-rgb), 0.32)');
  z-index: 2;
}

/* Same candy palette family as the hero note (#fff1a8 / #6a5430). */
.guestbook-card--p1 {
  --gb-paper: #ffddd6;
  --gb-ink: #7a463c;
  --gb-crease: rgba(122, 70, 60, 0.16);
}

.guestbook-card--p2 {
  --gb-paper: #d9efd7;
  --gb-ink: #44603f;
  --gb-crease: rgba(68, 96, 63, 0.16);
}

.guestbook-card--p3 {
  --gb-paper: #d8e9f8;
  --gb-ink: #3e5a76;
  --gb-crease: rgba(62, 90, 118, 0.16);
}

.guestbook-card--p4 {
  --gb-paper: #f6e4c6;
  --gb-ink: #6d5432;
  --gb-crease: rgba(109, 84, 50, 0.16);
}

.guestbook-card__tape {
  position: absolute;
  top: 48%;
  left: 50%;
  width: 28px;
  height: 28px;
  border-radius: 50%;
  background-color: var(--gb-tape);
  background-image:
    radial-gradient(circle at 50% 50%, rgba(255, 255, 255, 0.34) 0 2px, transparent 3px),
    var(--tape-stripes);
  box-shadow: 0 2px 6px unquote('rgba(var(--paper-shadow-rgb), 0.14)');
  filter: saturate(0.82);
  opacity: 0.78;
  transform: translate(-50%, -50%) rotate(4deg);
  z-index: 1;
}

.guestbook-card:nth-child(3n+2) .guestbook-card__tape {
  top: 46%;
  left: 48%;
  transform: translate(-50%, -50%) rotate(-5deg);
}

.guestbook-card:nth-child(4n) .guestbook-card__tape {
  top: 50%;
  left: 52%;
  transform: translate(-50%, -50%) rotate(6deg);
}

.guestbook-card:nth-child(2n) {
  transform-origin: 54% 38%;
}

.guestbook-card:nth-child(3n) {
  transform-origin: 42% 48%;
}

.guestbook-card__meta {
  display: grid;
  grid-template-columns: minmax(0, 1fr) auto;
  align-items: start;
  gap: 10px;
  margin-bottom: 12px;
}

.guestbook-card__avatar {
  flex: none;
  order: 2;
  width: 38px;
  height: 38px;
  border-radius: 4px;
  object-fit: cover;
  background: rgba(255, 255, 255, 0.55);
  border: 1px dashed currentColor;
  box-shadow: inset 0 0 0 3px rgba(255, 255, 255, 0.28), var(--paper-shadow);
}

.guestbook-card__avatar--text {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  color: inherit;
  font-size: 15px;
  font-weight: 700;
}

.guestbook-card__who {
  order: 1;
  display: flex;
  flex-direction: column;
  min-width: 0;
}

.guestbook-card__nick {
  color: inherit;
  font-size: 14px;
  font-weight: 700;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.guestbook-card__date {
  width: fit-content;
  margin-top: 2px;
  padding: 1px 6px;
  border: 1px dashed currentColor;
  border-radius: 2px;
  color: inherit;
  opacity: 0.62;
  font-size: 11px;
  font-style: normal;
  line-height: 1.35;
  letter-spacing: 0;
}

.guestbook-card__text {
  display: -webkit-box;
  flex: 1 1 auto;
  margin: 0;
  color: inherit;
  font-size: 13px;
  line-height: 1.62;
  white-space: pre-line;
  overflow-wrap: anywhere;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 5;
  overflow: hidden;
}

.guestbook-card__jump {
  display: inline-flex;
  margin-top: 10px;
  padding: 2px 0;
  border-bottom: 1px dashed currentColor;
  color: inherit;
  opacity: 0.68;
  font-size: 12px;
  text-decoration: none;
  transition: opacity 0.18s ease;
}

.guestbook-card__jump:hover {
  opacity: 1;
}

/* Brief highlight on the original Twikoo comment after a wall jump. */
.guestbook-jump-target {
  outline: 2px dashed var(--color-accent);
  outline-offset: 6px;
  border-radius: 4px;
}

.guestbook-wall__more {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  min-width: 132px;
  margin: 28px auto 0;
  padding: 8px 18px;
  border: none;
  background: transparent;
  color: var(--ink-soft);
  font-size: 13px;
  font-weight: 600;
  cursor: pointer;
  white-space: nowrap;
  transition: color 0.2s ease, transform 0.2s ease;
  z-index: 1;
}

.guestbook-wall__more::before {
  content: "";
  position: absolute;
  top: 0; left: 0; right: 0; bottom: 0;
  background: var(--paper-warm);
  z-index: -1;
  border-radius: var(--radius-handdrawn);
  box-shadow: inset 0 0 0 1px var(--dash);
  filter: url(#paper-edge) drop-shadow(var(--paper-shadow));
  transition: background 0.2s ease, box-shadow 0.2s ease;
}

.guestbook-wall__more:hover,
.guestbook-wall__more:focus-visible {
  color: var(--color-accent-strong);
  transform: translateY(-1px);
}

.guestbook-wall__more:hover::before,
.guestbook-wall__more:focus-visible::before {
  background: var(--color-accent-soft);
  box-shadow: inset 0 0 0 1px var(--color-accent);
}

.dark-mode .guestbook-wall__more::before {
  box-shadow: none;
}

@media (max-width: 640px) {
  .guestbook-wall__list {
    grid-template-columns: minmax(0, 1fr);
    gap: 18px;
  }

  .guestbook-card {
    min-height: 148px;
    margin: 3px;
    padding: 16px 14px 12px;
  }

  .guestbook-card__avatar {
    width: 34px;
    height: 34px;
  }

  .guestbook-card__meta {
    gap: 8px;
    margin-bottom: 8px;
  }

  .guestbook-card__text {
    font-size: 12px;
    line-height: 1.55;
    -webkit-line-clamp: 4;
  }
}

@media (prefers-reduced-motion: reduce) {
  .guestbook-card,
  .guestbook-wall__write,
  .guestbook-wall__more,
  .guestbook-card__jump {
    transition: none;
  }

  .guestbook-card:hover {
    transform: rotate(var(--gb-rotate));
  }
}
